# --- General Settings ---
# Set "False" for production, "True" for local development
DEBUG=True

# This is a dummy key for development. 
# IN PRODUCTION (Railway): Set a real key in the Dashboard Variables.
SECRET_KEY=django-insecure-change-me-for-production

# Allow all hosts for local dev; Railway handles this via variables in prod
ALLOWED_HOSTS=*

TIME_ZONE=Asia/Kolkata

# --- Database Connection ---
# We use DATABASE_URL as the primary connection method (Best for Railway)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horilla

# --- Database Details (Optional/Legacy) ---
# Keep these if your local setup specifically needs them, 
# but DATABASE_URL above handles all of this in one line.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=horilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Google Cloud (Optional) ---
# Keep commented unless you are actively using Google Cloud Storage
# GOOGLE_APPLICATION_CREDENTIALS="path/to/json"
# GS_BUCKET_NAME="your-bucket-name"